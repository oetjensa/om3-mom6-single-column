 &MOM_input_nml
         output_directory = './',
         restart_input_dir = './',
         restart_output_dir = './',
         parameter_filename = 'MOM_input',
                              'MOM_override' /

 &diag_manager_nml
         flush_nc_files = .true.
         max_axes = 400
         max_files = 200
         max_num_axis_sets = 200 /

 &fms_nml
         clock_grain = 'LOOP',
         domains_stack_size = 710000,
         stack_size = 0 /

&generic_tracer_nml
         do_generic_tracer=.true.
         do_generic_WOMBATmid=.true. /

&generic_wombatmid_nml
         do_bac_remin=.false.
         do_constant_sinking=.true.
         do_check_c_conserve=.true. 
         do_emulator_shadow = .false.
         use_remin_emulator = .true.
         remin_emulator_path = '/g/data/jk72/ao2582/ACCESS/wombat_dev/ACCESS-OM3/ftorch_model/model/remin_emulator_ts.pt' /
